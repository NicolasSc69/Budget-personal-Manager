<div class="mb-3">
    <label for="account-type-search" class="form-label required">{{ form.type.vars.label|trans }}</label>
    <div class="d-flex gap-2">
        <div class="position-relative flex-grow-1">
            <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="right: 0.75rem;"></i>
            <input type="text" id="account-type-search" class="form-control pe-4" autocomplete="off" placeholder="{{ 'Search an account type…'|trans }}">
            <div id="account-type-search-results" class="list-group position-absolute w-100 shadow-sm" style="z-index: 1050; display: none; max-height: 240px; overflow-y: auto;"></div>
        </div>
        <button type="button" class="btn btn-outline-secondary flex-shrink-0" data-bs-toggle="modal" data-bs-target="#quickAccountTypeModal">
            <i class="bi bi-plus-lg"></i> {{ 'New'|trans }}
        </button>
    </div>
    {{ form_widget(form.type, {'attr': {'class': 'd-none'}}) }}
    {% for error in form.type.vars.errors %}
        <div class="text-danger small mt-1">{{ error.message }}</div>
    {% endfor %}
</div>
