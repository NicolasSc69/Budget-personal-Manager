{% extends 'base.html.twig' %}

{% block title %}{{ 'Accounts'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'Accounts'|trans }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> {{ 'Back'|trans }}
            </a>
            <a href="{{ path('app_account_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> {{ 'New account'|trans }}
            </a>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ 'Label'|trans }}</th>
                        <th>{{ 'Type'|trans }}</th>
                        <th>{{ 'Person'|trans }}</th>
                        <th class="text-end">{{ 'Balance'|trans }}</th>
                        <th class="text-center">{{ 'Recurring transactions to duplicate'|trans }}</th>
                        <th class="text-end">{{ 'Actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for account in accounts %}
                    <tr>
                        <td>
                            <a href="{{ path('app_dashboard_account', {'id': account.id}) }}" data-account-nav="{{ account_nav_message(account) }}">{{ account.label }}{% if account.person %} ({{ account.person.name }}){% endif %}</a>
                        </td>
                        <td><span class="badge text-bg-secondary">{{ account.type.name }}</span></td>
                        <td>
                            {% if account.person %}
                                <span class="badge text-bg-secondary">{{ account.person.name }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end {{ balances[account.id] < 0 ? 'amount-negative' : 'amount-positive' }}">
                            {{ balances[account.id]|money }}
                        </td>
                        <td class="text-center">
                            {% if pendingRecurringCounts[account.id] > 0 %}
                                <a href="{{ path('app_transaction_recurring', {'account': account.id}) }}" class="btn btn-sm btn-outline-warning">
                                    {{ pendingRecurringCounts[account.id] }}
                                </a>
                            {% else %}
                                <span class="text-muted">0</span>
                            {% endif %}
                        </td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('app_account_show', {'id': account.id}) }}" class="btn btn-sm btn-outline-secondary" data-ajax-modal data-title="{{ 'Account details'|trans }}">{{ 'View'|trans }}</a>
                            <a href="{{ path('app_account_edit', {'id': account.id}) }}" class="btn btn-sm btn-outline-secondary" data-ajax-modal data-title="{{ 'Edit account'|trans }}">{{ 'Edit'|trans }}</a>
                            {{ include('account/_delete_form.html.twig', {buttonClass: 'btn-sm'}) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">{{ 'No account yet'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ include('_pagination.html.twig', {routeName: 'app_account_index', currentPage: currentPage, totalPages: totalPages}) }}

    <div class="mt-3 d-flex gap-3">
        <a href="{{ path('app_account_type_index') }}" class="text-muted small">{{ 'Manage account types'|trans }}</a>
        <a href="{{ path('app_person_index') }}" class="text-muted small">{{ 'Manage people'|trans }}</a>
    </div>
{% endblock %}
