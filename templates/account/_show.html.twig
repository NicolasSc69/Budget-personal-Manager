<div class="card">
    <div class="card-body">
        <table class="table mb-0">
            <tbody>
                <tr>
                    <th style="width: 200px;">{{ 'Label'|trans }}</th>
                    <td>{{ account.label }}</td>
                </tr>
                <tr>
                    <th>{{ 'Type'|trans }}</th>
                    <td><span class="badge text-bg-secondary">{{ account.type.name }}</span></td>
                </tr>
                <tr>
                    <th>{{ 'Person'|trans }}</th>
                    <td>
                        {% if account.person %}
                            <span class="badge text-bg-secondary">{{ account.person.name }}</span>
                        {% else %}
                            <span class="text-muted">{{ 'None'|trans }}</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>{{ 'Initial balance'|trans }}</th>
                    <td>{{ (account.initialBalance ?? 0)|money }}</td>
                </tr>
                <tr>
                    <th>{{ 'Savings'|trans }}</th>
                    <td>
                        {% if account.savings %}
                            <span class="badge text-bg-info">{{ 'Yes'|trans }}</span>
                            {% if account.interestRate %}
                                — {{ 'Rate:'|trans }} {{ account.interestRate|number_format(2, ',', ' ') }} %
                            {% endif %}
                            {% if account.maxAmount %}
                                — {{ 'Target:'|trans }} {{ account.maxAmount|money }}
                            {% endif %}
                        {% else %}
                            {{ 'No'|trans }}
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a href="{{ path('app_dashboard_account', {'id': account.id}) }}" class="btn btn-outline-primary" data-account-nav="{{ account_nav_message(account) }}">{{ 'View dashboard'|trans }}</a>
    <a href="{{ path('app_account_edit', {'id': account.id}) }}" class="btn btn-primary" data-ajax-modal data-title="{{ 'Edit account'|trans }}">{{ 'Edit'|trans }}</a>
    {{ include('account/_delete_form.html.twig') }}
    <a href="#" class="btn btn-outline-secondary" data-role="cancel">{{ 'Close'|trans }}</a>
</div>
