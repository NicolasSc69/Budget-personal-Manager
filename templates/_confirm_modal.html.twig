<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true" style="z-index: 1070;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalTitle">{{ 'Confirmation'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            <div class="modal-body" id="confirmModalMessage"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="button" class="btn btn-primary" id="confirmModalOk">{{ 'Confirm'|trans }}</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const modalEl = document.getElementById('confirmModal');
    const messageEl = document.getElementById('confirmModalMessage');
    const okButton = document.getElementById('confirmModalOk');

    if (!modalEl || !messageEl || !okButton) {
        return;
    }

    let resolvePending = null;

    // Keep the backdrop of this modal above any modal already open (e.g. the ajax modal).
    modalEl.addEventListener('shown.bs.modal', () => {
        const backdrops = document.querySelectorAll('.modal-backdrop');
        if (backdrops.length > 1) {
            backdrops[backdrops.length - 1].style.zIndex = '1065';
        }
    });

    modalEl.addEventListener('hidden.bs.modal', () => {
        // Bootstrap removes "modal-open" from body even if another modal is still displayed.
        if (document.querySelector('.modal.show')) {
            document.body.classList.add('modal-open');
        }

        if (resolvePending) {
            resolvePending(false);
            resolvePending = null;
        }
    });

    okButton.addEventListener('click', () => {
        if (resolvePending) {
            resolvePending(true);
            resolvePending = null;
        }
        bootstrap.Modal.getOrCreateInstance(modalEl).hide();
    });

    /**
     * Shows a confirmation popin and resolves with true if the user confirms.
     *
     * @param {string} message
     * @param {{variant?: string}} options variant: Bootstrap color of the confirm button (primary, danger...)
     * @returns {Promise<boolean>}
     */
    window.confirmDialog = function (message, options = {}) {
        if (resolvePending) {
            resolvePending(false);
        }

        messageEl.textContent = message;
        okButton.className = 'btn btn-' + (options.variant || 'primary');

        return new Promise((resolve) => {
            resolvePending = resolve;
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });
    };

    // Forms with data-confirm="message" ask for confirmation before submitting.
    // Capture phase so it runs before the ajax modal submit handlers.
    document.addEventListener('submit', async (event) => {
        const form = event.target.closest('form[data-confirm]');
        if (!form) {
            return;
        }

        if (form.dataset.confirmed === '1') {
            delete form.dataset.confirmed;
            return;
        }

        event.preventDefault();
        event.stopImmediatePropagation();

        const submitter = event.submitter;
        if (await window.confirmDialog(form.dataset.confirm, { variant: form.dataset.confirmVariant })) {
            form.dataset.confirmed = '1';
            form.requestSubmit(submitter && submitter.form === form ? submitter : undefined);
        }
    }, true);
})();
</script>
