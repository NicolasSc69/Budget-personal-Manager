{{ form_start(form, formAction is defined and formAction ? {'action': formAction} : {}) }}
    <div class="mb-3">
        {{ form_label(form.name) }}
        <div class="position-relative">
            <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="right: 0.75rem;"></i>
            {{ form_widget(form.name) }}
            <div id="existing-category-results" class="list-group position-absolute w-100 shadow-sm" style="z-index: 1050; display: none; max-height: 240px; overflow-y: auto;"></div>
        </div>
        {{ form_help(form.name) }}
        {{ form_errors(form.name) }}
    </div>
    {{ form_row(form.color) }}
    {{ form_row(form.parent) }}
    {{ form_row(form.excludedFromForecast) }}
    <div class="mt-3">
        <button class="btn btn-primary">{{ (button_label|default('Save'))|trans }}</button>
        <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary" data-role="cancel">{{ 'Cancel'|trans }}</a>
    </div>
{{ form_end(form) }}

<script>
(function () {
    const existingCategories = {{ existingCategoriesJson|default('[]')|raw }};
    const nameInput = document.getElementById('{{ form.name.vars.id }}');
    const resultsBox = document.getElementById('existing-category-results');

    if (!nameInput || !resultsBox) {
        return;
    }

    function hideResults() {
        resultsBox.style.display = 'none';
        resultsBox.innerHTML = '';
    }

    function renderResults(query) {
        const matches = existingCategories.filter((c) => c.name.toLowerCase().includes(query.toLowerCase()));
        resultsBox.innerHTML = '';

        matches.forEach((category) => {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2';
            item.innerHTML = '<span class="badge" style="background-color:' + category.color + ';">&nbsp;&nbsp;&nbsp;</span> ' + category.name;
            item.addEventListener('click', () => {
                nameInput.value = category.name.split(' › ').pop();
                hideResults();
            });
            resultsBox.appendChild(item);
        });

        resultsBox.style.display = matches.length > 0 ? 'block' : 'none';
    }

    nameInput.addEventListener('input', () => {
        const query = nameInput.value.trim();
        if (!query) {
            hideResults();
            return;
        }
        renderResults(query);
    });

    document.addEventListener('click', (event) => {
        if (event.target !== nameInput && !resultsBox.contains(event.target)) {
            hideResults();
        }
    });
})();
</script>
