{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">{{ category.name }}</h1>

    <div class="card">
        <div class="card-body">
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th style="width: 200px;">{{ 'Name'|trans }}</th>
                        <td>{{ category.name }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'Color'|trans }}</th>
                        <td>
                            <span class="badge" style="background-color: {{ category.color }};">&nbsp;&nbsp;&nbsp;</span>
                            {{ category.color }}
                        </td>
                    </tr>
                    <tr>
                        <th>{{ 'Parent tag'|trans }}</th>
                        <td>
                            {% if category.parent %}
                                <a href="{{ path('app_category_show', {'id': category.parent.id}) }}">{{ category.parent.fullName }}</a>
                            {% else %}
                                <span class="text-muted">{{ 'None (root tag)'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% if category.children|length > 0 %}
                    <tr>
                        <th>{{ 'Sub-tags'|trans }}</th>
                        <td>
                            {% for child in category.children %}
                                <a href="{{ path('app_category_show', {'id': child.id}) }}" class="badge text-bg-light border me-1">{{ child.name }}</a>
                            {% endfor %}
                        </td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary">{{ 'Back'|trans }}</a>
        <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-primary">{{ 'Edit'|trans }}</a>
        {{ include('category/_delete_form.html.twig') }}
    </div>
{% endblock %}
