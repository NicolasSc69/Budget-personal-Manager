<form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" data-confirm="{{ 'Delete this tag?'|trans }}" data-confirm-variant="danger" class="d-inline" data-native-submit>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    {% if category.transactions is not empty %}
        <button class="btn btn-outline-danger {{ buttonClass|default('') }}" type="button" disabled title="{{ 'Cannot delete: transactions are attached to this tag'|trans }}">{{ 'Delete'|trans }}</button>
    {% else %}
        <button class="btn btn-outline-danger {{ buttonClass|default('') }}">{{ 'Delete'|trans }}</button>
    {% endif %}
</form>
