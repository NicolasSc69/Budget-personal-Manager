{% extends 'base.html.twig' %}

{% block title %}{{ 'Tags'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'Tags'|trans }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> {{ 'Back'|trans }}
            </a>
            <form method="post" action="{{ path('app_category_randomize_colors') }}" data-confirm="{{ 'Randomly shuffle the colors of all tags?'|trans }}">
                <input type="hidden" name="_token" value="{{ csrf_token('randomize_category_colors') }}">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-palette"></i> {{ 'Randomize colors'|trans }}
                </button>
            </form>
            <a href="{{ path('app_category_import') }}" class="btn btn-outline-secondary">
                <i class="bi bi-upload"></i> {{ 'Import tags'|trans }}
            </a>
            <a href="{{ path('app_category_new') }}" class="btn btn-primary" data-ajax-modal data-title="{{ 'New tag'|trans }}">
                <i class="bi bi-plus-lg"></i> {{ 'New tag'|trans }}
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" action="{{ path('app_category_index') }}" class="row g-2 align-items-end" id="category-filter-form">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="filter-search">{{ 'Name'|trans }}</label>
                    <input type="text" id="filter-search" name="search" value="{{ filterSearch }}" placeholder="{{ 'Search a tag…'|trans }}" class="form-control form-control-sm">
                </div>
                <div class="col-auto">
                    <a href="{{ path('app_category_index') }}" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-lg"></i> {{ 'Reset'|trans }}
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ 'Color'|trans }}</th>
                        <th>{{ 'Name'|trans }}</th>
                        <th class="text-center">{{ 'Transactions'|trans }}</th>
                        <th class="text-end">{{ 'Actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for category in categories %}
                    <tr>
                        <td>
                            <span class="badge" style="background-color: {{ category.color }};">&nbsp;&nbsp;&nbsp;</span>
                            <span class="text-muted small">{{ category.color }}</span>
                        </td>
                        <td>
                            <span style="padding-left: {{ category.ancestors|length * 1.5 }}rem;">
                                {% if not category.root %}<i class="bi bi-arrow-return-right text-muted"></i>{% endif %}
                                {{ category.name }}
                                {% if category.excludedFromForecast %}
                                    <span class="badge text-bg-secondary" title="{{ 'Do not take into account for the projected balance calculation'|trans }}">{{ 'Excluded from forecast'|trans }}</span>
                                {% endif %}
                            </span>
                        </td>
                        <td class="text-center">
                            <a href="{{ path('app_transaction_index', {'category': category.id}) }}" class="badge text-bg-light border text-decoration-none">
                                {{ transactionCounts[category.id] ?? 0 }}
                            </a>
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-sm btn-outline-secondary" data-ajax-modal data-title="{{ 'Tag detail'|trans }}">{{ 'View'|trans }}</a>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-outline-secondary" data-ajax-modal data-title="{{ 'Edit tag'|trans }}">{{ 'Edit'|trans }}</a>
                            {{ include('category/_delete_form.html.twig', {buttonClass: 'btn-sm'}) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">{{ 'No tags yet'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ include('_pagination.html.twig', {routeName: 'app_category_index', currentPage: currentPage, totalPages: totalPages, queryParams: queryParams}) }}
{% endblock %}

{% block javascripts %}
    <script>
    (function () {
        const form = document.getElementById('category-filter-form');
        if (!form) {
            return;
        }

        let debounceTimer = null;

        form.querySelectorAll('input[type="text"]').forEach((field) => {
            field.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => form.submit(), 500);
            });
        });
    })();
    </script>
{% endblock %}
