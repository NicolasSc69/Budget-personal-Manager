<form method="post" action="{{ path('app_person_delete', {'id': person.id}) }}" onsubmit="return confirm('{{ 'Delete this person?'|trans|e('js') }}');" class="d-inline" data-native-submit>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ person.id) }}">
    {% if person.accounts is not empty %}
        <button class="btn btn-outline-danger {{ buttonClass|default('') }}" type="button" disabled title="{{ 'Cannot delete: accounts use this person'|trans }}">{{ 'Delete'|trans }}</button>
    {% else %}
        <button class="btn btn-outline-danger {{ buttonClass|default('') }}">{{ 'Delete'|trans }}</button>
    {% endif %}
</form>
