{{ form_start(form, formAction is defined and formAction ? {'action': formAction} : {}) }}
    {{ form_widget(form) }}
    <div class="mt-3 d-flex flex-wrap flex-sm-nowrap align-items-center gap-2">
        <button class="btn btn-primary">{{ button_label|default('Save'|trans) }}</button>
        <a href="{{ path('app_person_index') }}" class="btn btn-outline-secondary" data-role="cancel">{{ 'Cancel'|trans }}</a>
    </div>
{{ form_end(form) }}
