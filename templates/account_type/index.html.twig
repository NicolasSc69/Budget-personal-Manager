{% extends 'base.html.twig' %}

{% block title %}{{ 'Account types'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'Account types'|trans }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('app_account_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> {{ 'Back'|trans }}
            </a>
            <a href="{{ path('app_account_type_new') }}" class="btn btn-primary" data-ajax-modal data-title="{{ 'New account type'|trans }}">
                <i class="bi bi-plus-lg"></i> {{ 'New type'|trans }}
            </a>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>{{ 'Name'|trans }}</th>
                        <th class="text-end">{{ 'Actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for account_type in account_types %}
                    <tr>
                        <td>{{ account_type.name }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_account_type_edit', {'id': account_type.id}) }}" class="btn btn-sm btn-outline-secondary" data-ajax-modal data-title="{{ 'Edit account type'|trans }}">{{ 'Edit'|trans }}</a>
                            {{ include('account_type/_delete_form.html.twig', {buttonClass: 'btn-sm'}) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="text-center text-muted py-4">{{ 'No account type yet'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
