<form method="post" action="{{ path('app_transaction_delete', {'id': transaction.id}) }}" data-confirm="{{ 'Delete this transaction?'|trans }}" data-confirm-variant="danger" class="d-inline" data-native-submit>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ transaction.id) }}">
    <input type="hidden" name="redirectTo" value="{{ app.request.requestUri }}">
    <button class="btn btn-outline-danger {{ buttonClass|default('') }}">{{ 'Delete'|trans }}</button>
</form>
