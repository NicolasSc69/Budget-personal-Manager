{% extends 'base.html.twig' %}

{% block title %}{{ 'Administration'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'Administration'|trans }}</h1>
        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> {{ 'Back'|trans }}
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6">{{ 'Database'|trans }}</h2>
            <table class="table table-sm mb-0">
                <tbody>
                    <tr>
                        <th style="width: 220px;">{{ 'Accounts'|trans }}</th>
                        <td>{{ accountCount }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'Tags'|trans }}</th>
                        <td>{{ categoryCount }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'Transactions'|trans }}</th>
                        <td>{{ transactionCount }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'File size'|trans }}</th>
                        <td>{{ dbSize is not null ? (dbSize / 1024)|number_format(1, ',', ' ') ~ ' KB' : '—' }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'Last modified'|trans }}</th>
                        <td>{{ dbModifiedAt ? dbModifiedAt|date('d/m/Y H:i:s') : '—' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6">{{ 'Cache'|trans }}</h2>
            <p class="text-muted small">
                {{ 'Clears the application cache (Twig, configuration, routes...). Useful after an update or in case of incorrect display.'|trans }}
            </p>
            {% if caches %}
                <table class="table table-sm mb-3">
                    <thead>
                        <tr>
                            <th>{{ 'Environment'|trans }}</th>
                            <th>{{ 'Files'|trans }}</th>
                            <th>{{ 'Size'|trans }}</th>
                            <th>{{ 'Last modified'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cache in caches %}
                            <tr>
                                <td>
                                    {{ cache.env }}
                                    {% if cache.current %}<span class="badge text-bg-secondary ms-1">{{ 'current'|trans }}</span>{% endif %}
                                </td>
                                <td>{{ cache.fileCount }}</td>
                                <td>{{ (cache.size / 1024)|number_format(1, ',', ' ') }} KB</td>
                                <td>{{ cache.modifiedAt ? cache.modifiedAt|date('d/m/Y H:i:s') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <p class="text-muted small">
                    <i class="bi bi-info-circle"></i>
                    {{ 'The environment marked "current" is the one serving this very page, so Symfony immediately rebuilds the part of its cache needed to display the page you land on after clearing — it will never show up empty here. This does not mean clearing failed: check its "Last modified" date, it will show the exact time you clicked, proving the previous cache was actually deleted first.'|trans }}
                </p>
            {% endif %}
            <form method="post" action="{{ path('app_admin_clear_cache') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_clear_cache') }}">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i> {{ 'Clear cache'|trans }}
                </button>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6">{{ 'Display'|trans }}</h2>
            <form method="post" action="{{ path('app_admin_settings') }}" class="row g-2 align-items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_settings') }}">
                <div class="col-auto">
                    <label class="form-label small mb-1" for="items-per-page">{{ 'Items per page (transactions / tags / accounts lists)'|trans }}</label>
                    <input type="number" id="items-per-page" name="items_per_page" value="{{ itemsPerPage }}" min="5" max="200" class="form-control form-control-sm">
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-1" for="theme">{{ 'Theme'|trans }}</label>
                    <select id="theme" name="theme" class="form-select form-select-sm">
                        <option value="auto" {{ theme == 'auto' ? 'selected' : '' }}>{{ 'Automatic (follow device preference)'|trans }}</option>
                        <option value="light" {{ theme == 'light' ? 'selected' : '' }}>{{ 'Light'|trans }}</option>
                        <option value="dark" {{ theme == 'dark' ? 'selected' : '' }}>{{ 'Dark'|trans }}</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-primary">{{ 'Save'|trans }}</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6">{{ 'Automatic backup'|trans }}</h2>
            <p class="text-muted small">
                {{ 'If a directory is provided, a copy of the database is automatically saved there on every change (creation, edit, deletion). Leave the field empty to disable automatic backup.'|trans }}
            </p>
            <div class="row g-2 align-items-end mb-3">
                <form method="post" action="{{ path('app_admin_backup_settings') }}" class="col-auto d-flex gap-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_backup_settings') }}">
                    <div style="min-width: 320px;">
                        <label class="form-label small mb-1" for="backup-directory">{{ 'Backup directory (absolute path)'|trans }}</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="backup-directory" name="backup_directory" value="{{ backupDirectory }}" placeholder="/path/to/backups" class="form-control form-control-sm">
                            <button type="button" id="backup-directory-browse-btn" class="btn btn-sm btn-outline-secondary flex-shrink-0">
                                <i class="bi bi-folder2-open"></i> {{ 'Browse'|trans }}
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">{{ 'Save'|trans }}</button>
                </form>
                {% if backupDirectory %}
                    <form method="post" action="{{ path('app_admin_backup') }}" class="col-auto">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_backup') }}">
                        <input type="hidden" name="redirectTo" value="{{ app.request.requestUri }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-shield-check"></i> {{ 'Back up now'|trans }}
                        </button>
                    </form>
                {% endif %}
            </div>

            {% if backupDirectory %}
                {% if backupFileExists %}
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">compta-backup.db ({{ backupFileModifiedAt|date('d/m/Y H:i') }})</span>
                        <a href="{{ path('app_admin_backup_download') }}" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-download"></i> {{ 'Download backup'|trans }}
                        </a>
                    </div>
                {% else %}
                    <p class="text-muted small mb-0">{{ 'No backup yet.'|trans }}</p>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h6 mb-1">{{ 'Unit tests'|trans }}</h2>
                {% if testReport.ran %}
                    <span class="text-muted small">
                        {{ testReport.totals.tests }} {{ 'Tests'|trans|lower }},
                        <span class="{{ (testReport.totals.failures + testReport.totals.errors) > 0 ? 'amount-negative' : 'amount-positive' }}">
                            {{ testReport.totals.failures + testReport.totals.errors }} {{ 'Failures / errors'|trans|lower }}
                        </span>
                        — {{ 'Last run: %date%'|trans({'%date%': testReport.generatedAt|date('d/m/Y H:i:s')}) }}
                    </span>
                {% else %}
                    <span class="text-muted small">{{ 'No test report yet. Click "Run tests" to generate one.'|trans }}</span>
                {% endif %}
            </div>
            <a href="{{ path('app_admin_tests') }}" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-clipboard2-check"></i> {{ 'View test report'|trans }}
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">{{ 'Export'|trans }}</h2>
                    <p class="text-muted small">
                        {{ 'Downloads a full copy of the database (SQLite file): accounts, tags, account types and transactions.'|trans }}
                    </p>
                    <a href="{{ path('app_admin_export') }}" class="btn btn-primary">
                        <i class="bi bi-download"></i> {{ 'Download database'|trans }}
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">{{ 'Import'|trans }}</h2>
                    <p class="text-muted small">
                        {{ 'Replaces'|trans }} <strong>{{ 'all current data'|trans }}</strong> {{ 'with the contents of a file exported from this application. A backup of the current database is automatically kept next to the file before the import.'|trans }}
                    </p>
                    <form method="post" action="{{ path('app_admin_import') }}" enctype="multipart/form-data" data-confirm="{{ 'Importing this file will replace ALL current data. Continue?'|trans }}" data-confirm-variant="danger">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_import') }}">
                        <div class="mb-3">
                            <input type="file" name="database_file" accept=".db,.sqlite,.sqlite3" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-upload"></i> {{ 'Import and replace'|trans }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="backupDirectoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Choose a directory'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">{{ 'Current folder:'|trans }} <code id="backup-browser-current-path"></code></p>
                    <div class="list-group" id="backup-browser-list" style="max-height: 300px; overflow-y: auto;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                    <button type="button" class="btn btn-primary" id="backup-browser-select-btn">{{ 'Choose this folder'|trans }}</button>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        const input = document.getElementById('backup-directory');
        const browseBtn = document.getElementById('backup-directory-browse-btn');
        const modalEl = document.getElementById('backupDirectoryModal');
        const currentPathEl = document.getElementById('backup-browser-current-path');
        const listEl = document.getElementById('backup-browser-list');
        const selectBtn = document.getElementById('backup-browser-select-btn');

        if (!input || !browseBtn || !modalEl) {
            return;
        }

        let currentPath = '/';

        function addEntry(icon, label, onClick) {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2';
            item.innerHTML = '<i class="bi ' + icon + '"></i> ' + label;

            if (onClick) {
                item.addEventListener('click', onClick);
            } else {
                item.disabled = true;
            }

            listEl.appendChild(item);
        }

        function load(path) {
            fetch('{{ path('app_admin_backup_browse') }}?path=' + encodeURIComponent(path))
                .then((response) => response.json())
                .then((data) => {
                    currentPath = data.path;
                    currentPathEl.textContent = data.path;
                    listEl.innerHTML = '';

                    if (data.parent) {
                        addEntry('bi-arrow-90deg-up', {{ 'Parent folder'|trans|json_encode|raw }}, () => load(data.parent));
                    }

                    if (0 === data.directories.length && !data.parent) {
                        addEntry('bi-slash-circle', {{ 'No subfolder'|trans|json_encode|raw }}, null);
                    }

                    data.directories.forEach((name) => {
                        const fullPath = ('/' === data.path ? '' : data.path) + '/' + name;
                        addEntry('bi-folder', name, () => load(fullPath));
                    });
                });
        }

        browseBtn.addEventListener('click', () => {
            load(input.value.trim() || '/');
            window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });

        selectBtn.addEventListener('click', () => {
            input.value = currentPath;
            window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
        });
    })();
    </script>
{% endblock %}
